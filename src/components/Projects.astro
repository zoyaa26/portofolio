<style>

/* =========================================================
   PROJECTS
   ========================================================= */

.projects {
  position: relative;

  width: 100%;

  padding:
    120px 6vw 110px;

  background:
  #e1e8d2;

  color:
    var(--text);

  overflow: hidden;

  transition:
    background 0.5s ease,
    color 0.5s ease;
}


.projects-container {
  width:
    min(1100px, 100%);

  margin:
    0 auto;
}


/* =========================================================
   SECTION LABEL
   ========================================================= */

.section-label {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-bottom:
    60px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  letter-spacing:
    1.2px;

  text-transform:
    uppercase;

  color:
    var(--text-soft);
}


.section-label span:first-child {
  opacity: 0.5;
}


.section-label .line {
  width: 38px;

  height: 1px;

  background:
    var(--text);

  opacity: 0.25;
}


/* =========================================================
   HEADER
   ========================================================= */

.projects-header {
  text-align:
    center;

  max-width:
    720px;

  margin:
    0 auto 60px;
}


.eyebrow {
  margin:
    0 0 12px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    14px;

  font-style:
    italic;

  color:
    var(--primary);
}


.projects-header h2 {
  margin:
    0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(38px, 5vw, 56px);

  font-weight:
    500;

  line-height:
    1;

  letter-spacing:
    -2px;

  color:
    var(--text);
}


.projects-description {
  max-width:
    550px;

  margin:
    20px auto 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    13px;

  line-height:
    1.75;

  color:
    var(--text-soft);
}


/* =========================================================
   PROJECT GRID
   ========================================================= */

.projects-grid {
  display:
    grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap:
    20px;
}


/* =========================================================
   PROJECT CARD
   ========================================================= */

.project-card {
  display:
    flex;

  flex-direction:
    column;

  min-width:
    0;

  padding:
    16px;

  border:
    1px solid
    var(--border);

  border-radius:
    18px;

  background:
    color-mix(
      in srgb,
      var(--surface) 75%,
      transparent
    );

  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}


.project-card:hover {
  transform:
    translateY(-4px);

  border-color:
    color-mix(
      in srgb,
      var(--primary) 30%,
      var(--border)
    );

  box-shadow:
    0 18px 40px
    rgba(40, 50, 40, 0.08);
}


/* =========================================================
   PROJECT VISUAL
   ========================================================= */

.project-visual {
  position:
    relative;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    100%;

  aspect-ratio:
    16 / 9;

  margin-bottom:
    24px;

  border-radius:
    12px;

  overflow:
    hidden;

  transition:
    transform 0.4s ease;
}


.project-card:hover .project-visual {
  transform:
    scale(1.01);
}


/* Decorative circles */

.project-visual::before {
  content:
    "";

  position:
    absolute;

  width:
    180px;

  height:
    180px;

  border-radius:
    50%;

  top:
    -90px;

  right:
    -50px;

  background:
    rgba(79, 112, 85, 0.12);
}


.project-visual::after {
  content:
    "";

  position:
    absolute;

  width:
    140px;

  height:
    140px;

  border-radius:
    50%;

  bottom:
    -70px;

  left:
    -40px;

  background:
    rgba(138, 90, 68, 0.1);
}


/* Individual visual backgrounds */

.project-visual.nayera {
  background:
    linear-gradient(
      135deg,
      #dfe9d5,
      #f3ead7
    );
}


.project-visual.one-archi {
  background:
    linear-gradient(
      135deg,
      #e5e5df,
      #d8ddd7
    );
}


.project-visual.finance {
