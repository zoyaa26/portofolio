<style>

/* ================================================= */
/* PROJECTS */
/* ================================================= */

.projects {
  position: relative;

  min-height: 100svh;

  padding:
    130px 8vw;

  background:
    var(--background);

  color:
    var(--text);
}


.projects-container {
  width: min(1180px, 100%);

  margin: 0 auto;
}


/* ================================================= */
/* SECTION LABEL */
/* ================================================= */

.section-label {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 70px;

  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);
}


.section-label span:first-child {
  font-size: 11px;

  opacity: 0.65;
}


.section-label .line {
  width: 42px;

  height: 1px;

  background:
    var(--primary);

  opacity: 0.5;
}


/* ================================================= */
/* HEADER */
/* ================================================= */

.projects-header {
  display: grid;

  grid-template-columns:
    minmax(300px, 1fr)
    minmax(250px, 0.65fr);

  gap: 100px;

  align-items: end;

  margin-bottom: 75px;
}


.eyebrow {
  margin: 0 0 18px;

  font-family:
    Georgia,
    serif;

  font-size: 15px;

  font-style: italic;

  color:
    var(--primary);
}


.projects-header h2 {
  max-width: 650px;

  margin: 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 68px);

  line-height: 0.98;

  letter-spacing: -2.5px;

  font-weight: 500;
}


.projects-header h2 span {
  display: block;

  color:
    var(--primary);
}


.projects-description {
  max-width: 430px;

  margin: 0;

  font-size: 14px;

  line-height: 1.85;

  color:
    var(--text-soft);
}


/* ================================================= */
/* PROJECT LIST */
/* ================================================= */

.projects-list {
  border-top:
    1px solid
    var(--border);
}


/* ================================================= */
/* PROJECT */
/* ================================================= */

.project {
  padding:
    55px 0;

  border-bottom:
    1px solid
    var(--border);
}


.project-main {
  display: grid;

  grid-template-columns:
    minmax(350px, 0.9fr)
    minmax(350px, 1fr);

  gap: 90px;

  align-items: center;
}


.project-number {
  margin-bottom: 25px;

  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);

  opacity: 0.7;
}


/* ================================================= */
/* PROJECT INFO */
/* ================================================= */

.project-info {
  max-width: 500px;
}


.project-type {
  margin: 0 0 14px;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color:
    var(--text-soft);

  opacity: 0.8;
}


.project-info h3 {
  margin: 0 0 18px;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(32px, 3vw, 46px);

  line-height: 1;

  letter-spacing: -1.5px;

  font-weight: 500;
}


.project-description {
  max-width: 470px;

  margin: 0;

  font-size: 13px;

  line-height: 1.8;

  color:
    var(--text-soft);
}


/* ================================================= */
/* TECHNOLOGIES */
/* ================================================= */

.project-tech {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 25px;
}


.project-tech span {
  padding:
    6px 10px;

  border:
    1px solid
    var(--border);

  border-radius: 999px;

  font-size: 10px;

  color:
    var(--text-soft);
}


/* ================================================= */
/* PROJECT LINKS */
/* ================================================= */

.project-links {
  display: flex;

  gap: 10px;

  margin-top: 30px;
}


.project-link {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 42px;

  padding:
    0 18px;

  border-radius: 999px;

  text-decoration: none;

  font-family:
    Georgia,
    serif;

  font-size: 11px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}


.primary-link {
  background:
    #8a5a44;

  color:
    #fff8e8;

  border:
    1px solid
    #8a5a44;
}


.primary-link:hover {
  background:
    #9a674f;

  border-color:
    #9a674f;

  transform:
    translateY(-2px);
}


.secondary-link {
  background:
    rgba(250, 243, 220, 0.7);

  color:
    #5b4638;

  border:
    1px solid
    rgba(91, 70, 56, 0.2);
}


.secondary-link:hover {
  background:
    #fff8e8;

  transform:
    translateY(-2px);
}


/* ================================================= */
/* PROJECT VISUAL */
/* ================================================= */

.project-visual {
  min-height: 330px;

  display: flex;

  align-items: center;
  justify-content: center;
}


.visual-placeholder {
  position: relative;

  width: 100%;

  aspect-ratio: 16 / 10;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      #dfe8d3,
      #f4ead4
    );

  border:
    1px solid
    rgba(91, 70, 56, 0.12);

  overflow: hidden;

  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease;
}


.visual-placeholder::before {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  border-radius: 50%;

  background:
    rgba(79, 112, 85, 0.16);

  top: -90px;
  right: -50px;
}


.visual-placeholder::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  border-radius: 50%;

  background:
    rgba(138, 90, 68, 0.12);

  bottom: -90px;
  left: -50px;
}


.project:hover .visual-placeholder {
  transform:
    scale(1.015);

  box-shadow:
    0 18px 40px
    rgba(60, 40, 30, 0.1);
}


.visual-label {
  position: relative;

  z-index: 2;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 72px);

  font-weight: 500;

  color:
    #5b7059;

  letter-spacing: -3px;
}


.visual-hint {
  position: relative;

  z-index: 2;

  margin-top: 7px;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: 2px;

  color:
    #806b5b;

  opacity: 0.7;
}


/* ================================================= */
/* FOOTER */
/* ================================================= */

.projects-footer {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding-top: 30px;
}


.projects-footer p {
  margin: 0;

  font-family:
    Georgia,
    serif;

  font-size: 13px;

  font-style: italic;

  color:
    var(--text-soft);
}


.projects-footer span {
  font-size: 20px;

  color:
    var(--primary);
}


