<style>

/* ================================================= */
/* HERO */
/* ================================================= */

.hero {
  position: relative;

  min-height: 100svh;

  overflow: hidden;

  background: var(--bg);

  color: var(--text);

  transition:
    background 0.5s ease,
    color 0.5s ease;
}


/* ================================================= */
/* GHIBLI VIDEO */
/* ================================================= */

.hero-video {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  z-index: 0;

  opacity: 1;

  transition:
    opacity 0.6s ease;
}


/* ================================================= */
/* GHIBLI OVERLAY */
/* ================================================= */

.hero-overlay {
  position: absolute;

  inset: 0;

  z-index: 1;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(231, 239, 217, 0.94) 0%,
      rgba(231, 239, 217, 0.78) 24%,
      rgba(231, 239, 217, 0.35) 48%,
      rgba(231, 239, 217, 0.08) 72%,
      transparent 100%
    );

  transition:
    opacity 0.6s ease;
}


/* ================================================= */
/* FORMAL BACKGROUND */
/* ================================================= */

.formal-background {
  position: absolute;

  inset: 0;

  z-index: 0;

  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(0, 0, 0, 0.045),
      transparent 30%
    ),
    var(--bg);

  opacity: 0;

  pointer-events: none;

  transition:
    opacity 0.6s ease;
}


/* ================================================= */
/* FORMAL GRID */
/* ================================================= */

.formal-grid {
  position: absolute;

  inset: 0;

  background-image:
    linear-gradient(
      rgba(0, 0, 0, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.035) 1px,
      transparent 1px
    );

  background-size: 80px 80px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 85%
    );
}


/* ================================================= */
/* HERO CONTENT */
/* ================================================= */

.hero-content {
  position: absolute;

  z-index: 10;

  left: 13%;

  top: 50%;

  width: min(560px, 40vw);

  margin: 0;

  transform: translateY(-42%);

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  transition:
    left 0.5s ease,
    top 0.5s ease,
    transform 0.5s ease;
}


/* ================================================= */
/* EYEBROW */
/* ================================================= */

.eyebrow {
  margin: 0 0 18px;

  font-family: Georgia, serif;

  font-size: 16px;

  font-style: italic;

  color: var(--primary);

  transition:
    color 0.4s ease;
}


/* ================================================= */
/* TITLE */
/* ================================================= */

.hero h1 {
  max-width: 650px;

  margin: 0;

  font-family: Georgia, serif;

  font-size:
    clamp(
      48px,
      5.2vw,
      76px
    );

  line-height: 0.94;

  letter-spacing: -3px;

  color: var(--text);

  transition:
    color 0.4s ease;
}


.hero h1 span {
  display: block;

  color: var(--primary);

  transition:
    color 0.4s ease;
}


/* ================================================= */
/* TAGLINE */
/* ================================================= */

.tagline {
  max-width: 470px;

  margin: 26px 0 0;

  font-family: Georgia, serif;

  font-size: 24px;

  line-height: 1.4;

  color: var(--text);

  transition:
    color 0.4s ease;
}


.tagline em {
  display: block;

  color: var(--primary);

  transition:
    color 0.4s ease;
}


/* ================================================= */
/* DESCRIPTION */
/* ================================================= */

.description {
  max-width: 450px;

  margin: 14px 0 0;

  font-size: 14px;

  line-height: 1.75;

  color: var(--text-soft);

  transition:
    color 0.4s ease;
}


.mobile-description {
  display: none;
}


/* ================================================= */
/* BUTTONS */
/* ================================================= */

.actions {
  display: flex;

  align-items: center;

  gap: 14px;

  margin-top: 28px;
}


.primary,
.secondary {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 48px;

  padding: 0 23px;

  border-radius: 999px;

  text-decoration: none;

  font-family: Georgia, serif;

  font-size: 14px;

  font-weight: 600;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    border 0.3s ease,
    box-shadow 0.3s ease;
}


/* ================================================= */
/* PRIMARY */
/* ================================================= */

.primary {
  color: var(--cream);

  background: var(--primary);

  border: 1px solid transparent;

  box-shadow:
    0 8px 24px
    rgba(38, 57, 43, 0.18);
}


.primary:hover {
  background: var(--primary-hover);

  transform: translateY(-3px);

  box-shadow:
    0 12px 28px
    rgba(38, 57, 43, 0.25);
}


/* ================================================= */
/* SECONDARY */
/* ================================================= */

.secondary {
  color: var(--primary);

  background:
    rgba(245, 240, 216, 0.78);

  border:
    1px solid
    var(--border);

  backdrop-filter: blur(8px);
}


.secondary:hover {
  background: var(--surface);

  transform: translateY(-3px);
}


/* ================================================= */
/* FORMAL LABEL */
/* ================================================= */

.formal-label {
  position: absolute;

  left: 9vw;

  bottom: 45px;

  z-index: 10;

  display: flex;

  align-items: center;

  gap: 12px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  letter-spacing: 2px;

  color: var(--text-soft);

  opacity: 0;

  transform: translateY(10px);

  transition:
    opacity 0.5s ease,
    transform 0.5s ease;
}


.formal-label span {
  font-size: 11px;

  color: var(--primary);
}


/* ================================================= */
/* FORMAL LINE */
/* ================================================= */

.formal-line {
  position: absolute;

  left: 9vw;

  right: 9vw;

  bottom: 70px;

  height: 1px;

  background:
    var(--border);

  opacity: 0;

  transition:
    opacity 0.5s ease;
}


/* ================================================= */
/* FORMAL SCROLL */
/* ================================================= */

.formal-scroll {
  position: absolute;

  right: 9vw;

  bottom: 45px;

  z-index: 10;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 9px;

  letter-spacing: 2px;

  color: var(--text-soft);

  opacity: 0;

  transition:
    opacity 0.5s ease;
}


/* ================================================= */
/* ================================================= */
/* FORMAL MODE */
/* ================================================= */
/* ================================================= */

html[data-theme="formal"] .hero-video {
  opacity: 0;
}


html[data-theme="formal"] .hero-overlay {
  opacity: 0;
}


html[data-theme="formal"] .formal-background {
  opacity: 1;
}


html[data-theme="formal"] .hero-content {
  left: 9vw;

  top: 50%;

  width: min(700px, 65vw);

  transform: translateY(-45%);
}


html[data-theme="formal"] .eyebrow {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-style: normal;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: 3px;

  text-transform: uppercase;

  color: var(--text-soft);
}


html[data-theme="formal"] .hero h1 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    clamp(
      58px,
      8vw,
      120px
    );

  font-weight: 700;

  line-height: 0.9;

  letter-spacing: -6px;

  color: var(--text);
}


html[data-theme="formal"] .hero h1 span {
  color: var(--text);
}


html[data-theme="formal"] .tagline {
  max-width: 600px;

  margin-top: 35px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    clamp(
      22px,
      2.4vw,
      34px
    );

  line-height: 1.2;

  color: var(--text);
}


html[data-theme="formal"] .tagline em {
  display: inline;

  color: var(--text-soft);

  font-style: normal;
}


html[data-theme="formal"] .description {
  max-width: 560px;

  margin-top: 22px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;

  line-height: 1.7;

  color: var(--text-soft);
}


html[data-theme="formal"] .primary {
  color: #ffffff;

  background: #171717;

  border-radius: 4px;

  box-shadow: none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


html[data-theme="formal"] .primary:hover {
  background: #333333;

  box-shadow: none;
}


html[data-theme="formal"] .secondary {
  color: #171717;

  background: transparent;

  border:
    1px solid
    rgba(0, 0, 0, 0.2);

  border-radius: 4px;

  backdrop-filter: none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


html[data-theme="formal"] .secondary:hover {
  background: #ffffff;
}


html[data-theme="formal"] .formal-label,
html[data-theme="formal"] .formal-scroll {
  opacity: 1;

  transform: translateY(0);
}


html[data-theme="formal"] .formal-line {
  opacity: 1;
}


/* ================================================= */
/* TABLET */
/* ================================================= */

@media (max-width: 1100px) {

  .hero-content {
    left: 7vw;

    width: min(520px, 48vw);
  }


  .hero h1 {
    font-size:
      clamp(
        46px,
        6vw,
        68px
      );
  }


  .tagline {
    font-size: 22px;
  }


  html[data-theme="formal"] .hero h1 {
    font-size:
      clamp(
        52px,
        8vw,
        90px
      );
  }

}


/* ================================================= */
/* TABLET / SMALL LAPTOP */
/* ================================================= */

@media (max-width: 900px) {

  .hero-video {
    object-position: 65% center;
  }


  .hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(231, 239, 217, 0.90) 0%,
        rgba(231, 239, 217, 0.55) 35%,
        rgba(231, 239, 217, 0.10) 75%,
        transparent 100%
      );
  }


  .hero-content {
    left: 6vw;

    top: 45%;

    width: min(500px, 55vw);

    transform:
      translateY(-35%);
  }


  html[data-theme="formal"] .hero-content {
    left: 7vw;

    width: 70vw;
  }

}


/* ================================================= */
/* MOBILE */
/* ================================================= */

@media (max-width: 600px) {

  .hero {
    min-height: 100svh;
  }


  /* ----------------------------------------------- */
  /* VIDEO */
  /* ----------------------------------------------- */

  .hero-video {
    object-position: 70% center;
  }


  /* ----------------------------------------------- */
  /* OVERLAY */
  /* ----------------------------------------------- */

  .hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(231, 239, 217, 0.04) 0%,
        rgba(231, 239, 217, 0.01) 45%,
        transparent 100%
      );
  }


  /* ----------------------------------------------- */
  /* CONTENT */
  /* ----------------------------------------------- */

  .hero-content {
    left: 18px;

    right: 18px;

    top: 50%;

    width: auto;

    max-width: 430px;

    margin: 0 auto;

    transform:
      translateY(-50%);

    align-items: center;

    text-align: center;
  }


  /* ----------------------------------------------- */
  /* EYEBROW */
  /* ----------------------------------------------- */

  .eyebrow {
    margin-bottom: 10px;

    font-size: 13px;
  }


  /* ----------------------------------------------- */
  /* TITLE */
  /* ----------------------------------------------- */

  .hero h1 {
    max-width: 390px;

    font-size:
      clamp(
        39px,
        11vw,
        55px
      );

    line-height: 0.94;

    letter-spacing: -2.5px;
  }


  /* ----------------------------------------------- */
  /* TAGLINE */
  /* ----------------------------------------------- */

  .tagline {
    max-width: 320px;

    margin-top: 18px;

    font-size: 19px;

    line-height: 1.3;
  }


  /* ----------------------------------------------- */
  /* DESCRIPTION */
  /* ----------------------------------------------- */

  .desktop-description {
    display: none;
  }


  .mobile-description {
    display: block;

    max-width: 320px;

    margin-top: 12px;

    font-size: 12.5px;

    line-height: 1.6;
  }


  /* ----------------------------------------------- */
  /* BUTTONS */
  /* ----------------------------------------------- */

  .actions {
    justify-content: center;

    gap: 10px;

    margin-top: 20px;
  }


  .primary,
  .secondary {
    min-height: 44px;

    padding: 0 17px;

    font-size: 12px;
  }


  /* ----------------------------------------------- */
  /* FORMAL MOBILE */
  /* ----------------------------------------------- */

  html[data-theme="formal"] .hero-content {
    left: 18px;

    right: 18px;

    top: 50%;

    width: auto;

    transform:
      translateY(-50%);
  }


  html[data-theme="formal"] .eyebrow {
    font-size: 10px;

    letter-spacing: 2.5px;

    margin-bottom: 14px;
  }


  html[data-theme="formal"] .hero h1 {
    max-width: 360px;

    font-size:
      clamp(
        48px,
        14vw,
        68px
      );

    line-height: 0.91;

    letter-spacing: -3.5px;
  }


  html[data-theme="formal"] .tagline {
    max-width: 330px;

    margin-top: 24px;

    font-size: 20px;

    line-height: 1.25;
  }


  html[data-theme="formal"] .tagline em {
    display: block;

    margin-top: 4px;
  }


  html[data-theme="formal"] .mobile-description {
    display: block;

    max-width: 310px;

    font-size: 12.5px;

    line-height: 1.6;
  }


  html[data-theme="formal"] .primary,
  html[data-theme="formal"] .secondary {
    border-radius: 4px;

    min-height: 44px;

    padding: 0 16px;

    font-size: 12px;
  }


  .formal-label {
    left: 18px;

    bottom: 24px;
  }


  .formal-line {
    left: 18px;

    right: 18px;

    bottom: 48px;
  }


  .formal-scroll {
    display: none;
  }

}


/* ================================================= */
/* SMALL PHONE */
/* ================================================= */

@media (max-width: 380px) {

  .hero-content {
    left: 14px;

    right: 14px;
  }


  .hero h1 {
    font-size: 39px;

    letter-spacing: -2px;
  }


  .tagline {
    max-width: 290px;

    font-size: 18px;
  }


  .mobile-description {
    max-width: 280px;

    font-size: 11.5px;
  }


  .primary,
  .secondary {
    min-height: 42px;

    padding: 0 14px;

    font-size: 11px;
  }


  html[data-theme="formal"] .hero h1 {
    font-size: 44px;

    letter-spacing: -2.5px;
  }

}


/* ================================================= */
/* REDUCE MOTION */
/* ================================================= */

@media (prefers-reduced-motion: reduce) {

  .hero-video {
    display: none;
  }


  .hero {
    background:
      var(--bg);
  }


  .primary,
  .secondary {
    transition: none;
  }

}

</style>