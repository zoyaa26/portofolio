            </div>

            <h3>Education</h3>

            <p>
              S.Kom. at the Faculty of Computer Science, Universitas Muslim Indonesia
            </p>
          </div>


          <!-- CARD 03 -->
          <div class="about-card">
            <div class="card-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M7 9h10" />
                <path d="M7 13h4" />
                <path d="M7 16h7" />
