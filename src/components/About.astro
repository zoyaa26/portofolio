---
---

<section id="about" class="about">

  <div class="about-container">

    <!-- SECTION LABEL -->
    <div class="section-label">
      <span>01</span>
      <span class="line"></span>
      <span>About Me</span>
    </div>


    <!-- CONTENT -->
    <div class="about-grid">

      <!-- LEFT -->
      <div class="about-intro">

        <p class="eyebrow">
          A little story about me
        </p>

        <h2>
          Turning ideas into
          <span>something real.</span>
        </h2>

      </div>


      <!-- RIGHT -->
      <div class="about-content">

        <p class="about-text">
          I'm Eka Herlambang Budiansyah, a software developer
          who enjoys turning ideas and requirements into
          practical digital experiences.
        </p>

        <p class="about-text">
          My interests span across web, mobile, desktop,
          and IoT development. I enjoy learning how different
          technologies work together to solve real problems.
        </p>

        <p class="about-text">
          I believe good software is not only about writing code,
          but also about understanding the problem, creating
          useful solutions, and making technology easier to use.
        </p>


        <!-- QUICK INFO -->
        <div class="about-info">

          <div class="info-item">
            <span class="info-number">01</span>

            <div>
              <strong>Web Development</strong>
              <p>Modern and responsive web applications.</p>
            </div>
          </div>


          <div class="info-item">
            <span class="info-number">02</span>

            <div>
              <strong>Application Development</strong>
              <p>Mobile and desktop applications.</p>
            </div>
          </div>


          <div class="info-item">
            <span class="info-number">03</span>

            <div>
              <strong>IoT Development</strong>
              <p>Connecting software with real-world devices.</p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* ================================================= */
/* ABOUT */
/* ================================================= */

.about {
  position: relative;

  min-height: 100svh;

  padding:
    130px 8vw;

  background:
    var(--background);

  color:
    var(--text);

  overflow: hidden;
}


/* ================================================= */
/* CONTAINER */
/* ================================================= */

.about-container {
  width: min(1180px, 100%);

  margin: 0 auto;
}


/* ================================================= */
/* SECTION LABEL */
/* ================================================= */

.section-label {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-bottom: 80px;

  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);
}


.section-label span:first-child {
  font-size: 11px;

  opacity: 0.65;
}


.section-label .line {
  width: 42px;

  height: 1px;

  background:
    var(--primary);

  opacity: 0.5;
}


/* ================================================= */
/* GRID */
/* ================================================= */

.about-grid {
  display: grid;

  grid-template-columns:
    minmax(300px, 0.85fr)
    minmax(400px, 1fr);

  gap: 100px;

  align-items: start;
}


/* ================================================= */
/* INTRO */
/* ================================================= */

.about-intro {
  position: sticky;

  top: 140px;
}


.eyebrow {
  margin: 0 0 18px;

  font-family:
    Georgia,
    serif;

  font-size: 15px;

  font-style: italic;

  color:
    var(--primary);
}


.about-intro h2 {
  max-width: 500px;

  margin: 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 68px);

  line-height: 0.98;

  letter-spacing: -2.5px;

  font-weight: 500;

  color:
    var(--text);
}


.about-intro h2 span {
  display: block;

  color:
    var(--primary);
}


/* ================================================= */
/* CONTENT */
/* ================================================= */

.about-content {
  max-width: 600px;
}


.about-text {
  margin: 0 0 22px;

  font-size: 15px;

  line-height: 1.9;

  color:
    var(--text-soft);
}


/* ================================================= */
/* QUICK INFO */
/* ================================================= */

.about-info {
  margin-top: 48px;

  display: flex;

  flex-direction: column;

  gap: 0;
}


.info-item {
  display: grid;

  grid-template-columns: 42px 1fr;

  gap: 18px;

  padding: 20px 0;

  border-top:
    1px solid
    var(--border);
}


.info-item:last-child {
  border-bottom:
    1px solid
    var(--border);
}


.info-number {
  padding-top: 3px;

  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);

  opacity: 0.75;
}


.info-item strong {
  display: block;

  margin-bottom: 5px;

  font-family:
    Georgia,
    serif;

  font-size: 16px;

  font-weight: 500;

  color:
    var(--text);
}


.info-item p {
  margin: 0;

  font-size: 12px;

  line-height: 1.6;

  color:
    var(--text-soft);
}


/* ================================================= */
/* FORMAL MODE */
/* ================================================= */

html[data-theme="formal"] .about {
  background:
    #ffffff;

  color:
    #171717;
}


html[data-theme="formal"] .section-label {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color:
    #777777;
}


html[data-theme="formal"] .section-label .line {
  background:
    #171717;

  opacity: 0.25;
}


html[data-theme="formal"] .eyebrow {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-style: normal;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color:
    #777777;
}


html[data-theme="formal"] .about-intro h2 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-weight: 700;

  letter-spacing: -3px;

  color:
    #171717;
}


html[data-theme="formal"] .about-intro h2 span {
  color:
    #555555;
}


html[data-theme="formal"] .about-text {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color:
    #555555;

  line-height: 1.8;
}


html[data-theme="formal"] .info-item {
  border-color:
    #e5e5e5;
}


html[data-theme="formal"] .info-number {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color:
    #777777;
}


html[data-theme="formal"] .info-item strong {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-weight: 600;

  color:
    #171717;
}


html[data-theme="formal"] .info-item p {
  color:
    #777777;
}


/* ================================================= */
/* TABLET */
/* ================================================= */

@media (max-width: 900px) {

  .about {
    padding:
      110px 6vw;
  }


  .about-grid {
    grid-template-columns:
      1fr;

    gap: 55px;
  }


  .about-intro {
    position: static;
  }


  .about-intro h2 {
    max-width: 650px;
  }


  .about-content {
    max-width: 700px;
  }

}


/* ================================================= */
/* MOBILE */
/* ================================================= */

@media (max-width: 600px) {

  .about {
    min-height: auto;

    padding:
      90px 24px;
  }


  .section-label {
    margin-bottom: 55px;

    font-size: 11px;
  }


  .about-grid {
    gap: 42px;
  }


  .eyebrow {
    font-size: 13px;

    margin-bottom: 14px;
  }


  .about-intro h2 {
    font-size: 42px;

    line-height: 1;

    letter-spacing: -2px;
  }


  .about-text {
    font-size: 14px;

    line-height: 1.8;

    margin-bottom: 18px;
  }


  .about-info {
    margin-top: 38px;
  }


  .info-item {
    grid-template-columns:
      32px 1fr;

    gap: 12px;

    padding: 17px 0;
  }


  .info-item strong {
    font-size: 15px;
  }


  .info-item p {
    font-size: 11px;
  }

}


/* ================================================= */
/* VERY SMALL PHONE */
/* ================================================= */

@media (max-width: 380px) {

  .about {
    padding:
      80px 18px;
  }


  .section-label {
    margin-bottom: 45px;
  }


  .about-intro h2 {
    font-size: 36px;

    letter-spacing: -1.7px;
  }


  .about-text {
    font-size: 13px;
  }

}

</style>