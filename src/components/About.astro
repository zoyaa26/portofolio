          </div>

        </div>
      </div>

    </div>

  </div>
</section>


<style>
/* =================================================
   ABOUT SECTION
   ================================================= */

.about {
  position: relative;
  width: 100%;
  min-height: 100svh;

  padding: 100px 6vw 120px;

  background: var(--bg);
  color: var(--text);

  overflow: hidden;

  transition:
    background 0.5s ease,
    color 0.5s ease;
}


/* =================================================
   CONTAINER
   ================================================= */

.about-container {
  width: min(1320px, 100%);
  margin: 0 auto;
}


/* =================================================
   HEADER
   ================================================= */

.about-header {
  text-align: center;
  margin-bottom: 100px;
}

.section-label {
  margin: 0 0 12px;

  font-family: Georgia, "Times New Roman", serif;
  font-size: 18px;
  line-height: 1.4;

  color: var(--text);
}

.about-header h2 {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(52px, 6vw, 76px);
  font-weight: 400;
  line-height: 1;

  letter-spacing: -2.5px;

  color: var(--text);
}


/* =================================================
   MAIN GRID
   ================================================= */

.about-grid {
  display: grid;

  grid-template-columns:
    minmax(320px, 400px)
    minmax(0, 1fr);

  gap: clamp(60px, 8vw, 110px);

  align-items: start;
}


/* =================================================
   PHOTO
   ================================================= */

.about-photo {
  width: 100%;
  max-width: 400px;

  overflow: hidden;

  border-radius: 28px;

  background: var(--surface);

  box-shadow:
    0 20px 50px rgba(30, 45, 35, 0.08);
}

.about-photo img {
  display: block;

  width: 100%;
  height: auto;

  aspect-ratio: 4 / 5;

  object-fit: cover;

  filter: saturate(0.9);

  transition:
    transform 0.6s ease,
    filter 0.6s ease;
}

.about-photo:hover img {
  transform: scale(1.025);
  filter: saturate(1);
}


/* =================================================
   CONTENT
   ================================================= */

.about-content {
  width: 100%;
  max-width: 850px;
}


/* =================================================
   DESCRIPTION
   ================================================= */

.about-description {
  max-width: 850px;

  margin-bottom: 55px;
}

.about-description p {
  margin: 0 0 20px;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(17px, 1.5vw, 20px);
  line-height: 1.9;

  color: var(--text);
}

.about-description p:last-child {
  margin-bottom: 0;
}


/* =================================================
   CARDS
   ================================================= */

.about-cards {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 28px;
}


/* =================================================
   CARD
   ================================================= */

.about-card {
  min-height: 245px;

  padding: 28px 30px;

  border: 1px solid var(--border);
  border-radius: 16px;

  background: rgba(255, 255, 255, 0.28);

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.about-card:hover {
  transform: translateY(-5px);

  background: rgba(255, 255, 255, 0.55);

  border-color: rgba(79, 112, 85, 0.3);

  box-shadow:
    0 15px 35px rgba(40, 55, 42, 0.08);
}


/* =================================================
   CARD ICON
   ================================================= */

.card-icon {
  width: 48px;
  height: 48px;

  margin-bottom: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--primary);
}

.card-icon svg {
  width: 34px;
  height: 34px;

  stroke: currentColor;
  stroke-width: 1.5;

  stroke-linecap: round;
  stroke-linejoin: round;
}


/* =================================================
   CARD TEXT
   ================================================= */

.about-card h3 {
  margin: 0 0 18px;

  font-family: Georgia, "Times New Roman", serif;
  font-size: 19px;
  font-weight: 600;

  color: var(--text);
}

.about-card p {
  margin: 0;

  font-size: 14px;
  line-height: 1.7;

  color: var(--text-soft);
}


/* =================================================
   FORMAL MODE
   ================================================= */

html[data-theme="formal"] .about {
  background: #ffffff;
  color: #171717;
}

html[data-theme="formal"] .section-label,
html[data-theme="formal"] .about-header h2 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color: #171717;
}

html[data-theme="formal"] .section-label {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #777777;
}

html[data-theme="formal"] .about-header h2 {
  font-weight: 700;
  letter-spacing: -3px;
}

html[data-theme="formal"] .about-photo {
  border-radius: 0;

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.08);
}

html[data-theme="formal"] .about-photo img {
  filter: grayscale(100%);
}

html[data-theme="formal"] .about-description p {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color: #444444;
}

html[data-theme="formal"] .about-card {
  border-color: #e5e5e5;
  border-radius: 0;

  background: #ffffff;
}

html[data-theme="formal"] .about-card:hover {
  background: #fafafa;

  border-color: #cccccc;

  box-shadow:
    0 15px 35px rgba(0, 0, 0, 0.05);
}

html[data-theme="formal"] .card-icon {
  color: #333333;
}

html[data-theme="formal"] .about-card h3 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-weight: 600;

  color: #171717;
}

html[data-theme="formal"] .about-card p {
  color: #777777;
}


/* =================================================
   TABLET
   ================================================= */

@media (max-width: 900px) {
  .about {
    padding:
      90px 6vw 100px;
  }

  .about-header {
    margin-bottom: 70px;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 55px;
  }

  .about-photo {
    max-width: 420px;
    margin: 0 auto;
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .about-cards {
    gap: 18px;
  }

  .about-card {
    padding: 25px;
  }
}


/* =================================================
   MOBILE
   ================================================= */

@media (max-width: 600px) {
    .about {
    min-height: auto;

    padding:
      80px 22px 100px;
  }

  .about-header {
    margin-bottom: 55px;
  }

  .section-label {
    font-size: 15px;
  }

  .about-header h2 {
    font-size: 48px;
    letter-spacing: -2px;
  }

  .about-grid {
    gap: 45px;
  }

  .about-photo {
    max-width: 360px;

    border-radius: 20px;
  }

  .about-description {
    margin-bottom: 40px;
  }

  .about-description p {
    font-size: 16px;
    line-height: 1.8;
  }

  .about-cards {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .about-card {
    min-height: auto;

    padding: 25px;

    border-radius: 14px;
  }

  .card-icon {
    margin-bottom: 20px;
  }

  .about-card h3 {
    margin-bottom: 10px;
    font-size: 18px;
  }

  .about-card p {
    font-size: 13px;
  }
}


/* =================================================
   VERY SMALL PHONE
   ================================================= */

@media (max-width: 380px) {
.about {
    padding:
      70px 18px 90px;
 }

  .about-header h2 {
    font-size: 42px;
 }

  .about-description p {
    font-size: 15px;
  }

  .about-card {
    padding: 22px;
  }
}
</style>