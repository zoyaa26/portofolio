            <p>
              Java, JavaScript, TypeScript,
              Python, PHP, C++
            </p>
          </div>


          <!-- CARD 02 -->
          <div class="about-card">
            <div class="card-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path d="M12 3l8 4-8 4-8-4 8-4z" />
                <path d="M6 10v5c0 2 2.7 4 6 4s6-2 6-4v-5" />
                <path d="M20 7v6" />
