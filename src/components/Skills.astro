  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 9px;

  color:
    rgba(255, 255, 255, 0.3);
}


.github-error {
  gap: 7px;
}


.github-error a {
  color:
    #43d765;

  text-decoration: none;
