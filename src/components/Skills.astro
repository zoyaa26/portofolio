<section id="skills" class="skills">

  <div class="skills-container">

    <!-- SECTION HEADER -->
    <div class="section-label">
      <span>02</span>
      <span class="line"></span>
      <span>Skills</span>
    </div>


    <!-- HEADER -->
    <div class="skills-header">

      <div>
        <p class="eyebrow">
          What I work with
        </p>

        <h2>
          Tools I use to
          <span>build things.</span>
        </h2>
      </div>

      <p class="skills-description">
        A growing collection of technologies I use to
        design, develop, and connect digital experiences.
      </p>

    </div>


    <!-- SKILLS GRID -->
    <div class="skills-grid">

      <!-- WEB -->
      <article class="skill-card">

        <div class="card-top">
          <span class="card-number">01</span>
          <span class="card-arrow">↗</span>
        </div>

        <h3>
          Web Development
        </h3>

        <p>
          Building responsive and modern websites
          from interface to backend.
        </p>

        <div class="technology-list">
          <span>HTML5</span>
          <span>CSS</span>
          <span>JavaScript</span>
          <span>TypeScript</span>
          <span>React</span>
          <span>Next.js</span>
          <span>Node.js</span>
        </div>

      </article>


      <!-- MOBILE -->
      <article class="skill-card">

        <div class="card-top">
          <span class="card-number">02</span>
          <span class="card-arrow">↗</span>
        </div>

        <h3>
          Mobile Development
        </h3>

        <p>
          Creating mobile applications focused on
          practical functionality and usability.
        </p>

        <div class="technology-list">
          <span>Flutter</span>
          <span>Dart</span>
          <span>Java</span>
          <span>Android</span>
        </div>

      </article>


      <!-- DESKTOP -->
      <article class="skill-card">

        <div class="card-top">
          <span class="card-number">03</span>
          <span class="card-arrow">↗</span>
        </div>

        <h3>
          Desktop Development
        </h3>

        <p>
          Developing desktop applications for
          specific workflows and everyday tasks.
        </p>

        <div class="technology-list">
          <span>Java</span>
          <span>C++</span>
          <span>SQLite</span>
        </div>

      </article>


      <!-- IOT -->
      <article class="skill-card">

        <div class="card-top">
          <span class="card-number">04</span>
          <span class="card-arrow">↗</span>
        </div>

        <h3>
          IoT Development
        </h3>

        <p>
          Connecting software, sensors, and
          microcontrollers to real-world systems.
        </p>

        <div class="technology-list">
          <span>C++</span>
          <span>Python</span>
          <span>Microcontrollers</span>
          <span>Sensors</span>
        </div>

      </article>

    </div>


    <!-- OTHER TOOLS -->
    <div class="tools">

      <p class="tools-label">
        Also familiar with
      </p>

      <div class="tools-list">

        <span>PHP</span>
        <span>Git</span>
        <span>GitHub</span>
        <span>REST API</span>
        <span>JSON</span>
        <span>SQLite</span>
        <span>Postman</span>
        <span>npm</span>

      </div>

    </div>

  </div>

</section>


<style>

/* ================================================= */
/* SKILLS */
/* ================================================= */

.skills {
  position: relative;

  min-height: 100svh;

  padding:
    130px 8vw;

  background:
    var(--surface);

  color:
    var(--text);

  overflow: hidden;
}


.skills-container {
  width: min(1180px, 100%);

  margin: 0 auto;
}


/* ================================================= */
/* SECTION LABEL */
/* ================================================= */

.section-label {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 70px;

  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);
}


.section-label span:first-child {
  font-size: 11px;

  opacity: 0.65;
}


.section-label .line {
  width: 42px;

  height: 1px;

  background:
    var(--primary);

  opacity: 0.5;
}


/* ================================================= */
/* HEADER */
/* ================================================= */

.skills-header {
  display: grid;

  grid-template-columns:
    minmax(300px, 1fr)
    minmax(250px, 0.65fr);

  gap: 100px;

  align-items: end;

  margin-bottom: 70px;
}


.eyebrow {
  margin: 0 0 18px;

  font-family:
    Georgia,
    serif;

  font-size: 15px;

  font-style: italic;

  color:
    var(--primary);
}


.skills-header h2 {
  max-width: 600px;

  margin: 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 68px);

  line-height: 0.98;

  letter-spacing: -2.5px;

  font-weight: 500;
}


.skills-header h2 span {
  display: block;

  color:
    var(--primary);
}


.skills-description {
  max-width: 430px;

  margin: 0;

  font-size: 14px;

  line-height: 1.85;

  color:
    var(--text-soft);
}


/* ================================================= */
/* SKILLS GRID */
/* ================================================= */

.skills-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 18px;
}


/* ================================================= */
/* SKILL CARD */
/* ================================================= */

.skill-card {
  position: relative;

  min-height: 300px;

  padding: 30px;

  border:
    1px solid
    var(--border);

  border-radius: 20px;

  background:
    rgba(255, 255, 255, 0.22);

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease,
    box-shadow 0.35s ease;
}


.skill-card:hover {
  transform:
    translateY(-6px);

  border-color:
    rgba(138, 90, 68, 0.28);

  background:
    rgba(255, 255, 255, 0.38);

  box-shadow:
    0 16px 35px
    rgba(60, 40, 30, 0.08);
}


/* ================================================= */
/* CARD TOP */
/* ================================================= */

.card-top {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 45px;
}


.card-number {
  font-family:
    Georgia,
    serif;

  font-size: 12px;

  color:
    var(--primary);

  opacity: 0.7;
}


.card-arrow {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 34px;
  height: 34px;

  border:
    1px solid
    var(--border);

  border-radius: 50%;

  font-size: 16px;

  color:
    var(--text-soft);

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease;
}


.skill-card:hover .card-arrow {
  transform:
    translate(2px, -2px);

  background:
    #8a5a44;

  color:
    #fff8e8;

  border-color:
    #8a5a44;
}


/* ================================================= */
/* CARD CONTENT */
/* ================================================= */

.skill-card h3 {
  margin: 0 0 12px;

  font-family:
    Georgia,
    serif;

  font-size: 24px;

  font-weight: 500;

  color:
    var(--text);
}


.skill-card > p {
  max-width: 470px;

  margin: 0;

  font-size: 13px;

  line-height: 1.7;

  color:
    var(--text-soft);
}


/* ================================================= */
/* TECHNOLOGY LIST */
/* ================================================= */

.technology-list {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 27px;
}


.technology-list span {
  padding:
    6px 10px;

  border:
    1px solid
    var(--border);

  border-radius: 999px;

  font-size: 10px;

  color:
    var(--text-soft);

  background:
    rgba(250, 243, 220, 0.35);

  transition:
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}


.skill-card:hover .technology-list span {
  border-color:
    rgba(138, 90, 68, 0.18);
}


/* ================================================= */
/* OTHER TOOLS */
/* ================================================= */

.tools {
  display: flex;

  align-items: center;

  gap: 35px;

  margin-top: 45px;

  padding-top: 25px;

  border-top:
    1px solid
    var(--border);
}


.tools-label {
  flex-shrink: 0;

  margin: 0;

  font-family:
    Georgia,
    serif;

  font-size: 13px;

  font-style: italic;

  color:
    var(--text-soft);
}


.tools-list {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}


.tools-list span {
  padding:
    7px 11px;

  border-radius: 999px;

  background:
    rgba(138, 90, 68, 0.08);

  font-size: 10px;

  color:
    var(--text-soft);
}


/* ================================================= */
/* FORMAL MODE */
/* ================================================= */

html[data-theme="formal"] .skills {
  background:
    #f7f7f5;

  color:
    #171717;
}


html[data-theme="formal"] .section-label {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color:
    #777777;
}


html[data-theme="formal"] .section-label .line {
  background:
    #171717;

  opacity: 0.2;
}


html[data-theme="formal"] .eyebrow {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  font-style: normal;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color:
    #777777;
}


html[data-theme="formal"] .skills-header h2 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-weight: 700;

  letter-spacing: -3px;

  color:
    #171717;
}


html[data-theme="formal"] .skills-header h2 span {
  color:
    #555555;
}


html[data-theme="formal"] .skills-description {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color:
    #666666;
}


html[data-theme="formal"] .skill-card {
  background:
    #ffffff;

  border-color:
    #e4e4e4;

  border-radius: 12px;
}


html[data-theme="formal"] .skill-card:hover {
  border-color:
    #cfcfcf;

  background:
    #ffffff;

  box-shadow:
    0 15px 30px
    rgba(0, 0, 0, 0.06);
}


html[data-theme="formal"] .card-number {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color:
    #777777;
}


html[data-theme="formal"] .card-arrow {
  color:
    #555555;

  border-color:
    #dddddd;
}


html[data-theme="formal"] .skill-card:hover .card-arrow {
  background:
    #171717;

  border-color:
    #171717;

  color:
    #ffffff;
}


html[data-theme="formal"] .skill-card h3 {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 20px;

  font-weight: 600;

  color:
    #171717;
}


html[data-theme="formal"] .skill-card > p {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color:
    #666666;
}


html[data-theme="formal"] .technology-list span {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  background:
    #f5f5f5;

  border-color:
    #e1e1e1;

  color:
    #555555;
}


html[data-theme="formal"] .skill-card:hover .technology-list span {
  border-color:
    #d5d5d5;
}


html[data-theme="formal"] .tools {
  border-color:
    #dddddd;
}


html[data-theme="formal"] .tools-label {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-style: normal;

  color:
    #777777;
}


html[data-theme="formal"] .tools-list span {
  background:
    #eeeeee;

  color:
    #555555;
}


/* ================================================= */
/* TABLET */
/* ================================================= */

@media (max-width: 900px) {

  .skills {
    padding:
      110px 6vw;
  }


  .skills-header {
    grid-template-columns:
      1fr;

    gap: 30px;

    margin-bottom: 50px;
  }


  .skills-description {
    max-width: 600px;
  }


  .skills-grid {
    grid-template-columns:
      1fr;
  }

}


/* ================================================= */
/* MOBILE */
/* ================================================= */

@media (max-width: 600px) {

  .skills {
    min-height: auto;

    padding:
      90px 24px;
  }


  .section-label {
    margin-bottom: 50px;
  }


  .skills-header {
    margin-bottom: 45px;
  }


  .eyebrow {
    font-size: 13px;

    margin-bottom: 14px;
  }


  .skills-header h2 {
    font-size: 42px;

    letter-spacing: -2px;
  }


  .skills-description {
    font-size: 13px;

    line-height: 1.75;
  }


  .skills-grid {
    gap: 14px;
  }


  .skill-card {
    min-height: auto;

    padding: 24px;

    border-radius: 16px;
  }


  .card-top {
    margin-bottom: 38px;
  }


  .skill-card h3 {
    font-size: 22px;
  }


  .skill-card > p {
    font-size: 12px;
  }


  .technology-list {
    margin-top: 23px;
  }


  .tools {
    display: block;

    margin-top: 38px;
  }


  .tools-label {
    margin-bottom: 15px;
  }

}


/* ================================================= */
/* VERY SMALL PHONE */
/* ================================================= */

@media (max-width: 380px) {

  .skills {
    padding:
      80px 18px;
  }


  .skills-header h2 {
    font-size: 36px;

    letter-spacing: -1.7px;
  }


  .skill-card {
    padding: 21px;
  }


  .skill-card h3 {
    font-size: 20px;
  }

}

</style>