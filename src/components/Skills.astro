<script>
  const username = "zoyaa26";

  const graph =
    document.getElementById("github-contributions");

  const total =
    document.getElementById("github-total");


  async function loadGithubActivity() {

    if (!graph) return;

    try {

      const response = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`
      );

      if (!response.ok) {
        throw new Error("Failed to fetch GitHub data");
      }

      const data = await response.json();

      const contributions =
        Array.isArray(data.contributions)
          ? data.contributions
          : [];


      if (!contributions.length) {
        throw new Error("No contribution data");
      }


      /*
       * Total contributions
       */
      const contributionTotal =
        typeof data.total?.lastYear === "number"
          ? data.total.lastYear
          : contributions.reduce(
              (
                sum: number,
                item: { count: number }
              ) => sum + item.count,
              0
            );


      if (total) {
        total.textContent =
          `${contributionTotal} contributions`;
      }


      /*
       * Convert contribution days
       * into weekly columns.
       */
      const weeks: Array<
        Array<{
          date: string;
          count: number;
          level: number;
        }>
      > = [];


      let currentWeek: Array<{
        date: string;
        count: number;
        level: number;
      }> = [];


      for (const item of contributions) {

        const date =
          new Date(`${item.date}T00:00:00`);

        const day =
          date.getDay();


        /*
         * Add empty cells before
         * the first Sunday.
         */
        if (
          weeks.length === 0 &&
          currentWeek.length === 0 &&
          day > 0
        ) {

          for (
            let i = 0;
            i < day;
            i++
          ) {

            currentWeek.push({
              date: "",
              count: 0,
              level: 0
            });

          }

        }


        /*
         * Start new week.
         */
        if (
          day === 0 &&
          currentWeek.length > 0
        ) {

          weeks.push(currentWeek);

          currentWeek = [];

        }


        currentWeek.push({
          date: item.date,
          count: Number(item.count || 0),
          level: Math.min(
            Number(item.level || 0),
            4
          )
        });

      }


      if (currentWeek.length > 0) {
        weeks.push(currentWeek);
      }


      /*
       * Remove loading text.
       */
      graph.innerHTML = "";


      /*
       * Render contribution graph.
       */
      weeks.forEach(
        (week, weekIndex) => {

          const weekElement =
            document.createElement("div");

          weekElement.className =
            "github-week";


          week.forEach(
            (item, dayIndex) => {

              const cell =
                document.createElement("span");

              cell.className =
                `contribution-cell level-${item.level}`;


              /*
               * Empty cells are only
               * used for alignment.
               */
              if (!item.date) {

                cell.classList.add(
                  "empty-cell"
                );

              } else {

                cell.title =
                  `${item.count} contribution${
                    item.count === 1
                      ? ""
                      : "s"
                  } on ${item.date}`;

              }


              /*
               * Animation delay.
               */
              cell.style.animationDelay =
                `${(
                  weekIndex * 0.012 +
                  dayIndex * 0.006
                )}s`;


              weekElement.appendChild(cell);

            }
          );


          graph.appendChild(
            weekElement
          );

        }
      );


    } catch (error) {

      console.error(
        "GitHub activity error:",
        error
      );


      if (total) {
        total.textContent =
          "GitHub activity";
      }


      graph.innerHTML = `
        <div class="github-error">
          GitHub activity could not be loaded.
          <a
            href="https://github.com/${username}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open GitHub ↗
          </a>
        </div>
      `;

    }

  }


  loadGithubActivity();
</script>


<style>

.skills {
  position: relative;

  width: 100%;

  min-height: 100svh;

  padding:
    120px 6vw;

  background:
    var(--surface);

  color:
    var(--text);

  overflow: hidden;

  transition:
    background 0.5s ease,
    color 0.5s ease;
}


.skills-container {
  width:
    min(1100px, 100%);

  margin:
    0 auto;
}


/* =========================================================
   SECTION HEADER
   ========================================================= */

.section-header {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-bottom: 65px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 12px;

  color:
    var(--primary);
}


.section-header > span:first-child {
  font-size: 10px;

  opacity: 0.6;
}


.section-line {
  width: 40px;

  height: 1px;

  background:
    var(--primary);

  opacity: 0.4;
}


/* =========================================================
   INTRO
   ========================================================= */

.skills-intro {
  display: flex;
  justify-content: center;
  text-align: center;

  margin-bottom: 48px;}

.eyebrow {
  margin:
    0 0 15px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 14px;

  font-style: italic;

  color:
    var(--primary);
}


.skills-intro h2 {
  margin: 0;

  max-width: 650px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(42px, 5vw, 62px);

  font-weight: 500;

  line-height: 0.98;

  letter-spacing: -2.5px;
}


.skills-intro h2 span {
  display: block;

  color:
    var(--primary);
}


.intro-text {
  margin: 0;

  max-width: 390px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 13px;

  line-height: 1.8;

  color:
    var(--text-soft);
}


/* =========================================================
   GITHUB CARD
   ========================================================= */

.github-card {
  position: relative;

  width: 100%;

  padding: 20px;

  border:
    1px solid
    rgba(255, 255, 255, 0.07);

  border-radius: 18px;

  background:
    #101210;

  box-shadow:
    0 25px 60px
    rgba(0, 0, 0, 0.13);

  overflow: hidden;
}


/* =========================================================
   SUBTLE MOVING LIGHT
   ========================================================= */

.github-light {
  position: absolute;

  top: -100%;

  left: -30%;

  width: 140px;

  height: 300%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(67, 215, 101, 0.02),
      rgba(255, 255, 255, 0.07),
      rgba(67, 215, 101, 0.025),
      transparent
    );

  filter:
    blur(20px);

  transform:
    rotate(10deg);

  pointer-events: none;

  animation:
    githubLight 10s
    ease-in-out
    infinite;

  z-index: 1;
}


@keyframes githubLight {

  0% {
    left: -30%;
    opacity: 0;
  }

  15% {
    opacity: 1;
  }

  50% {
    opacity: 1;
  }

  85% {
    opacity: 1;
  }

  100% {
    left: 125%;
    opacity: 0;
  }

}


/* =========================================================
   GITHUB HEADER
   ========================================================= */

.github-header {
  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  padding-bottom: 18px;
}


.github-profile {
  display: flex;

  align-items: center;

  gap: 11px;
}


.github-avatar {
  display: flex;

  align-items: center;

  justify-content: center;

  width: 36px;

  height: 36px;

  border:
    1px solid
    rgba(67, 215, 101, 0.25);

  border-radius: 50%;

  background:
    #171c18;

  font-family:
    Georgia,
    serif;

  font-size: 14px;

  color:
    #43d765;
}


.github-info {
  display: flex;

  flex-direction: column;

  gap: 3px;
}


.github-info strong {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  color:
    rgba(255, 255, 255, 0.85);
}


.github-info span {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  color:
    rgba(255, 255, 255, 0.32);
}


.github-link {
  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding:
    8px 11px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.025);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  text-decoration: none;

  color:
    rgba(255, 255, 255, 0.48);

  transition:
    background 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}


.github-link:hover {
  background:
    rgba(67, 215, 101, 0.06);

  border-color:
    rgba(67, 215, 101, 0.25);

  color:
    #43d765;
}


/* =========================================================
   CONTRIBUTION
   ========================================================= */

.contribution {
  position: relative;

  z-index: 2;

  padding: 16px;

  border:
    1px solid
    rgba(255, 255, 255, 0.06);

  border-radius: 12px;

  background:
    #151815;
}


.contribution-top {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 18px;
}


.contribution-top h3 {
  margin: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  font-weight: 600;

  color:
    rgba(255, 255, 255, 0.78);
}


.contribution-top p {
  margin:
    5px 0 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  color:
    rgba(255, 255, 255, 0.28);
}


#github-total {
  padding-top: 2px;

  white-space: nowrap;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  color:
    #43d765;
}


/* =========================================================
   GRAPH
   ========================================================= */

.graph-wrapper {
  width: 100%;

  overflow-x: auto;

  overflow-y: hidden;

  padding-bottom: 3px;

  scrollbar-width: thin;
}


.github-graph {
  display: flex;

  gap: 4px;

  width: max-content;

  min-height: 70px;
}


:global(.github-week) {
  display: grid;

  grid-template-rows:
    repeat(7, 9px);

  gap: 3px;
}


:global(.contribution-cell) {
  display: block;

  width: 9px;

  height: 9px;

  border-radius: 2px;

  animation:
    contributionAppear
    0.55s
    ease
    both;

  transition:
    transform 0.2s ease,
    filter 0.2s ease;
}


:global(.contribution-cell:hover) {
  transform: scale(1.45);

  filter: brightness(1.25);

  z-index: 5;
}


:global(.contribution-cell.empty-cell) {
  visibility: hidden;
}


:global(.contribution-cell.level-0),
.level-0 {
  background: #182019;
}


:global(.contribution-cell.level-1),
.level-1 {
  background: #174a29;
}


:global(.contribution-cell.level-2),
.level-2 {
  background: #176b32;
}


:global(.contribution-cell.level-3),
.level-3 {
  background: #1f9a43;
}


:global(.contribution-cell.level-4),
.level-4 {
  background: #43d765;
}


@keyframes contributionAppear {

  from {
    opacity: 0;

    transform:
      scale(0.5);
  }

  to {
    opacity: 1;

    transform:
      scale(1);
  }

}


/* =========================================================
   LEGEND
   ========================================================= */

.legend {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 4px;

  margin-top: 12px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 7px;

  color:
    rgba(255, 255, 255, 0.28);
}


.legend i {
  display: block;

  width: 8px;

  height: 8px;

  border-radius: 2px;
}


/* =========================================================
   ERROR
